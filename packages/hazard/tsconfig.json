{
  "extends": "@naboflood/config/tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    // the data generator runs under Node's native type stripping, which needs
    // explicit `.ts` specifiers; every bundler here resolves them fine too
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["node_modules"]
}
