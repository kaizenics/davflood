{
  "name": "naboflood",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:web": "turbo run dev -F web",
    "dev:marketing": "turbo run dev -F marketing",
    "generate:data": "turbo run generate:data -F @naboflood/hazard",
    "validate:style": "turbo run validate:style -F @naboflood/hazard"
  },
  "devDependencies": {
    "@naboflood/config": "workspace:*",
    "@types/node": "^22.20.1",
    "turbo": "^2.10.7",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@10.30.0"
}
