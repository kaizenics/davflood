{
  "name": "davflood",
  "private": true,
  "version": "1.9.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "pnpm -F web dev",
    "build": "pnpm build:api && pnpm -F web build",
    "check-types": "tsc -p server && pnpm -r check-types",
    "validate:style": "pnpm -F @davflood/hazard validate:style",
    "build:api": "esbuild server/news.ts --bundle --platform=node --format=esm --target=node22 --outfile=api/news.js --log-level=warning \"--banner:js=// GENERATED by pnpm build:api from server/news.ts. Do not edit.\""
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@davflood/hazard": "workspace:*"
  },
  "devDependencies": {
    "@davflood/config": "workspace:*",
    "@types/node": "^22.20.1",
    "esbuild": "0.28.1",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@10.30.0"
}
