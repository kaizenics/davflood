{
  "extends": "@davflood/config/tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"],
    // Vercel's Node runtime provides fetch, Request and Response from the web,
    // not from node's globals
    "lib": ["ESNext", "DOM"]
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules"]
}
