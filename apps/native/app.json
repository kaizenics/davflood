{
  "expo": {
    "name": "NaboFlood",
    "slug": "naboflood",
    "scheme": "naboflood",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#060a0e",
    "icon": "./assets/images/icon.png",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#060a0e"
    },
    "android": {
      "package": "app.naboflood",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png",
        "backgroundColor": "#060a0e"
      },
      "edgeToEdgeEnabled": true
    },
    "ios": {
      "bundleIdentifier": "app.naboflood",
      "supportsTablet": false,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "NaboFlood can show your position on the flood hazard map. Location is optional and only used while the app is open — it is never stored or sent anywhere."
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-router",
      [
        "@maplibre/maplibre-react-native",
        {
          "android": {
            "nativeVariant": "opengl",
            "locationEngine": "default"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "NaboFlood can show your position on the flood hazard map. Location is optional and only used while the app is open — it is never stored or sent anywhere.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
