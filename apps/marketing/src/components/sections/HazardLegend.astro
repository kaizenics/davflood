---
import { hazardTiers } from "@/lib/site";

interface Props {
	class?: string;
	showDepth?: boolean;
}

const { class: className = "", showDepth = true } = Astro.props;

// full literal classes — Tailwind can't see interpolated names
const swatch = {
	low: "bg-haz-low",
	medium: "bg-haz-med",
	high: "bg-haz-high",
} as const;
---

<div class={`flex flex-wrap items-center gap-x-6 gap-y-3 ${className}`}>
	{
		hazardTiers.map((t) => (
			<div class="flex items-center gap-2.5">
				<span
					class={`size-3 rounded-[4px] ${swatch[t.id]}`}
					aria-hidden="true"
				/>
				{/* the label is never optional — colour alone is not an
				    accessible information channel, and this is safety UI */}
				<span class="text-ink text-sm font-semibold">{t.label}</span>
				{showDepth && (
					<span class="text-ink-dim text-sm" data-numeric>
						{t.depthShort}
					</span>
				)}
			</div>
		))
	}
</div>
