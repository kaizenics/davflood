---
import Section from "@/components/ui/Section.astro";
import { stats } from "@/lib/site";
---

<Section
	eyebrow="Why this exists"
	title="Most people find out their street floods by standing in it."
	lede="Hazard maps for Davao already exist — they sit in government PDFs and desktop GIS files that almost nobody outside a planning office ever opens. DavFlood puts the same data on the phone in your pocket, in language you can act on."
>
	<div class="mt-14 grid gap-px overflow-hidden sm:grid-cols-3">
		{
			stats.map((s) => (
				<div class="reveal border-hairline/60 flex flex-col gap-1 border-t py-8 sm:border-t-0 sm:border-l sm:px-8 sm:first:border-l-0 sm:first:pl-0">
					<span class="display-md text-tide" data-numeric>
						{s.value}
					</span>
					<span class="text-ink text-base font-semibold">{s.label}</span>
					<span class="text-ink-dim text-sm">{s.sub}</span>
				</div>
			))
		}
	</div>
</Section>
