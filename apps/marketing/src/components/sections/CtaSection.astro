---
import ContourBackdrop from "@/components/decor/ContourBackdrop.astro";
import GlowOrb from "@/components/decor/GlowOrb.astro";
import Button from "@/components/ui/Button.astro";
import Container from "@/components/ui/Container.astro";
import { store } from "@/lib/site";
import { Icon } from "astro-icon/components";
---

<section class="pb-24 sm:pb-32">
	<Container size="wide">
		<div
			class="rounded-card border-hairline/70 bg-surface/40 relative overflow-hidden border px-6 py-16 text-center sm:px-16 sm:py-20"
		>
			<ContourBackdrop class="text-tide" opacity={0.35} />
			<GlowOrb class="-bottom-52 left-1/2 -translate-x-1/2" size="40rem" />

			<div class="relative mx-auto flex max-w-2xl flex-col items-center gap-6">
				<div class="hazard-bar h-1 w-24 rounded-full opacity-80" aria-hidden="true"></div>
				<h2 class="display-lg">The map won't stop the flood.</h2>
				<p class="lede">
					But knowing you're in a 1.6-metre zone changes what you do at 3am when the rain
					hasn't stopped — and that's the whole point.
				</p>
				<div class="mt-2 flex flex-col gap-3 sm:flex-row sm:items-center">
					<Button
						href={store.released ? store.url : undefined}
						inert={!store.released}
						size="lg"
					>
						<Icon name="lucide:smartphone" class="size-[1.05rem]" aria-hidden="true" />
						{store.released ? store.labelReleased : store.label}
					</Button>
					<Button href="/about" variant="outline" size="lg">
						Read about the data
					</Button>
				</div>
			</div>
		</div>
	</Container>
</section>
