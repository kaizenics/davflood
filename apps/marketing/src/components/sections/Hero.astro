---
import ContourBackdrop from "@/components/decor/ContourBackdrop.astro";
import GlowOrb from "@/components/decor/GlowOrb.astro";
import MapMockup from "@/components/mockup/MapMockup.astro";
import PhoneFrame from "@/components/mockup/PhoneFrame.astro";
import Badge from "@/components/ui/Badge.astro";
import Button from "@/components/ui/Button.astro";
import Container from "@/components/ui/Container.astro";
import { site, store } from "@/lib/site";
import { Icon } from "astro-icon/components";
import HazardLegend from "./HazardLegend.astro";
---

<section class="relative overflow-hidden pt-16 pb-20 sm:pt-24 sm:pb-28">
	<ContourBackdrop class="text-tide" opacity={0.4} />
	<GlowOrb class="-top-40 -right-32" size="46rem" />
	<GlowOrb
		class="top-1/2 -left-56"
		size="34rem"
		color="oklch(0.5 0.09 250 / 0.35)"
	/>

	<Container size="wide" class="relative">
		<div class="grid items-center gap-16 lg:grid-cols-[1.05fr_0.95fr] lg:gap-10">
			<div class="flex flex-col items-start gap-7">
				<Badge dot>Free · {site.city}, {site.province}</Badge>

				<h1 class="display-xl">
					Know the water<br />
					<span class="text-tide-fade">before it comes.</span>
				</h1>

				<p class="lede max-w-xl">
					A 3D flood hazard map for every barangay in {site.city}. See how deep the
					water is expected to get where you live — for an ordinary storm, a bad one,
					and the worst one on record.
				</p>

				<div class="flex flex-col gap-3 sm:flex-row sm:items-center">
					<Button
						href={store.released ? store.url : undefined}
						inert={!store.released}
						size="lg"
					>
						<Icon name="lucide:smartphone" class="size-[1.05rem]" aria-hidden="true" />
						{store.released ? store.labelReleased : store.label}
					</Button>
					<Button href="/#how-it-works" variant="outline" size="lg">
						How it works
						<Icon name="lucide:arrow-down" class="size-[1.05rem]" aria-hidden="true" />
					</Button>
				</div>

				<p class="text-ink-dim -mt-2 text-xs">{store.note} No account, no ads.</p>

				<div class="border-hairline/60 mt-2 w-full border-t pt-6">
					<p
						class="text-ink-dim mb-3 text-[0.7rem] font-semibold tracking-[0.16em] uppercase"
					>
						Hazard levels
					</p>
					<HazardLegend />
				</div>
			</div>

			<div class="relative flex justify-center lg:justify-end">
				<div
					class="hazard-bar absolute -inset-x-8 top-1/2 -z-10 h-px opacity-20 blur-[2px]"
					aria-hidden="true"
				>
				</div>
				<PhoneFrame tilt class="w-[16rem] sm:w-[18.5rem]">
					<MapMockup variant="map" class="block w-full" />
				</PhoneFrame>
			</div>
		</div>
	</Container>
</section>
