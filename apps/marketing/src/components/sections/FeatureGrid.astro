---
import Card from "@/components/ui/Card.astro";
import Section from "@/components/ui/Section.astro";
import { features } from "@/lib/site";
import { Icon } from "astro-icon/components";
---

<Section
	id="features"
	eyebrow="What it does"
	title="Everything you need to read your own risk."
	lede="No dashboards, no jargon, no login. Open it, find your barangay, understand what you're looking at."
>
	<div class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
		{
			features.map((f) => (
				<Card class={`reveal flex flex-col gap-4 ${f.wide ? "lg:col-span-3" : ""}`}>
					<span class="border-hairline/70 bg-raised/60 inline-flex size-11 items-center justify-center rounded-xl border">
						<Icon name={f.icon} class="text-tide size-5" aria-hidden="true" />
					</span>
					<h3 class="text-ink text-lg font-semibold">{f.title}</h3>
					<p class="text-ink-dim max-w-2xl text-[0.94rem] leading-relaxed">{f.body}</p>
				</Card>
			))
		}
	</div>
</Section>
