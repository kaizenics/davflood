---
import Container from "@/components/ui/Container.astro";
import { disclaimer } from "@/lib/site";
import { Icon } from "astro-icon/components";
---

<div class="border-hairline/60 border-y">
	<Container size="wide">
		<div class="flex flex-col gap-4 py-6 sm:flex-row sm:items-start sm:gap-5">
			<span
				class="bg-haz-med/12 border-haz-med/35 inline-flex size-9 shrink-0 items-center justify-center rounded-xl border"
			>
				<Icon name="lucide:triangle-alert" class="text-haz-med size-4.5" aria-hidden="true" />
			</span>
			<div class="flex flex-col gap-1">
				<p class="text-ink text-sm font-semibold">{disclaimer.short}</p>
				<p class="text-ink-dim max-w-3xl text-sm leading-relaxed">
					{disclaimer.long}
				</p>
			</div>
		</div>
	</Container>
</div>
