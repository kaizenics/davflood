---
interface Props {
	class?: string;
	/** subtle 3D tilt — off for the flat screenshot strip */
	tilt?: boolean;
	glow?: boolean;
}

const { class: className = "", tilt = false, glow = true } = Astro.props;

const tiltStyle = tilt
	? "transform: perspective(1400px) rotateY(-13deg) rotateX(4deg) rotateZ(1.2deg);"
	: "";
---

<div
	class={`relative ${className}`}
	style={tiltStyle}
>
	<!-- bezel -->
	<div
		class="relative rounded-[2.35rem] border border-white/10 bg-gradient-to-b from-[#2b323d] to-[#12151b] p-[3px]"
		style={glow ? "box-shadow: var(--shadow-glow);" : "box-shadow: var(--shadow-lift);"}
	>
		<div class="rounded-[2.2rem] bg-[#0b0e13] p-[5px]">
			<div class="relative overflow-hidden rounded-[1.85rem] bg-[#12161d]">
				<slot />
				<!-- dynamic-island style cutout -->
				<div
					class="absolute top-[2.2%] left-1/2 h-[1.9%] w-[26%] -translate-x-1/2 rounded-full bg-[#05070a]"
					aria-hidden="true"
				>
				</div>
			</div>
		</div>
	</div>

	<!-- side buttons -->
	<div
		class="absolute top-[18%] -left-[2px] h-[6%] w-[3px] rounded-l bg-[#2b323d]"
		aria-hidden="true"
	>
	</div>
	<div
		class="absolute top-[27%] -left-[2px] h-[9%] w-[3px] rounded-l bg-[#2b323d]"
		aria-hidden="true"
	>
	</div>
	<div
		class="absolute top-[24%] -right-[2px] h-[11%] w-[3px] rounded-r bg-[#2b323d]"
		aria-hidden="true"
	>
	</div>
</div>
