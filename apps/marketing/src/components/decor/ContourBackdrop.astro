---
/**
 * Topographic contour texture. Nested scales of one irregular closed
 * curve read convincingly as elevation contours — which is the whole
 * visual thesis of the site: flooding is a story about terrain.
 *
 * Purely decorative, hidden from assistive tech.
 */

interface Props {
	class?: string;
	opacity?: number;
}

const { class: className = "", opacity = 0.5 } = Astro.props;

// one irregular closed curve, drawn once and scaled about its centre
const blob =
	"M200,52 C288,50 356,108 362,192 C368,278 302,344 212,350 C124,356 52,300 44,216 C36,132 112,54 200,52 Z";

const rings = [1, 0.9, 0.8, 0.71, 0.62, 0.54, 0.46, 0.38, 0.31, 0.24, 0.17, 0.11];
---

<div
	class={`pointer-events-none absolute inset-0 overflow-hidden ${className}`}
	style={`opacity:${opacity}`}
	aria-hidden="true"
>
	<svg
		class="h-full w-full"
		viewBox="0 0 1200 800"
		preserveAspectRatio="xMidYMid slice"
		fill="none"
	>
		<defs>
			<linearGradient id="contour-fade" x1="0" y1="0" x2="0" y2="1">
				<stop offset="0%" stop-color="oklch(0.78 0.12 205)" stop-opacity="0.5"></stop>
				<stop offset="55%" stop-color="oklch(0.55 0.11 210)" stop-opacity="0.22"></stop>
				<stop offset="100%" stop-color="oklch(0.55 0.11 210)" stop-opacity="0"></stop>
			</linearGradient>
			<mask id="contour-mask">
				<rect width="1200" height="800" fill="url(#contour-fade)"></rect>
			</mask>
		</defs>

		<g mask="url(#contour-mask)" stroke="currentColor" class="text-tide" fill="none">
			<!-- ridge one -->
			<g transform="translate(120 -40) scale(1.55)">
				{
					rings.map((s) => (
						<path
							d={blob}
							stroke-width={0.7 / s}
							transform={`translate(200 200) scale(${s}) translate(-200 -200)`}
						/>
					))
				}
			</g>
			<!-- ridge two, flipped for variety -->
			<g transform="translate(900 340) scale(1.15) rotate(24 200 200)">
				{
					rings.map((s) => (
						<path
							d={blob}
							stroke-width={0.9 / s}
							transform={`translate(200 200) scale(${s}) translate(-200 -200)`}
						/>
					))
				}
			</g>
			<!-- ridge three, small, low -->
			<g transform="translate(430 430) scale(0.8)">
				{
					rings.slice(3).map((s) => (
						<path
							d={blob}
							stroke-width={1 / s}
							transform={`translate(200 200) scale(${s}) translate(-200 -200)`}
						/>
					))
				}
			</g>
		</g>
	</svg>
</div>
