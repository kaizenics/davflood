---
interface Props {
	variant?: "primary" | "outline" | "ghost";
	size?: "md" | "lg";
	href?: string;
	external?: boolean;
	/** renders as a non-interactive element — used for the unreleased store CTA */
	inert?: boolean;
	class?: string;
}

const {
	variant = "primary",
	size = "md",
	href,
	external = false,
	inert = false,
	class: className = "",
} = Astro.props;

const base =
	"inline-flex items-center justify-center gap-2 rounded-pill font-semibold transition duration-200 whitespace-nowrap";

const sizes = {
	md: "px-5 py-2.5 text-sm",
	lg: "px-6 py-3.5 text-base",
};

const variants = {
	primary:
		"bg-tide text-abyss hover:bg-ink hover:-translate-y-0.5 shadow-[0_10px_30px_-12px_oklch(0.78_0.12_205/0.6)]",
	outline:
		"border border-hairline text-ink hover:border-tide hover:text-tide hover:-translate-y-0.5",
	ghost: "text-ink-dim hover:text-ink",
};

const cls = `${base} ${sizes[size]} ${variants[variant]} ${className}`;
const rel = external ? "noopener noreferrer" : undefined;
const target = external ? "_blank" : undefined;
---

{
	inert ? (
		<span
			class={`${base} ${sizes[size]} border-hairline text-ink-dim cursor-default border border-dashed ${className}`}
		>
			<slot />
		</span>
	) : href ? (
		<a href={href} rel={rel} target={target} class={cls}>
			<slot />
		</a>
	) : (
		<button type="button" class={cls}>
			<slot />
		</button>
	)
}
