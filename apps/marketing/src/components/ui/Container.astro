---
interface Props {
	size?: "narrow" | "default" | "wide";
	class?: string;
	as?: string;
}

// destructured to `tag` rather than `as` — `as as any` parses ambiguously,
// and the explicit cast is needed because the polymorphic `as` prop stops
// Astro inferring `Props` on its own
const {
	size = "default",
	class: className = "",
	as: tag = "div",
} = Astro.props as Props;

const widths = {
	narrow: "max-w-3xl",
	default: "max-w-6xl",
	wide: "max-w-7xl",
};

const Tag = tag as any;
---

<Tag class={`mx-auto w-full px-5 sm:px-8 ${widths[size]} ${className}`}>
	<slot />
</Tag>
