---
import Wordmark from "@/components/brand/Wordmark.astro";
import Button from "@/components/ui/Button.astro";
import Container from "@/components/ui/Container.astro";
import { nav, store } from "@/lib/site";
import { Icon } from "astro-icon/components";

const path = Astro.url.pathname;
const isActive = (href: string) =>
	href.startsWith("/#") ? false : path === href || path === `${href}/`;
---

<header class="sticky top-0 z-40">
	<div
		class="border-hairline/60 bg-abyss/70 border-b backdrop-blur-xl backdrop-saturate-150"
	>
		<Container size="wide">
			<div class="flex h-16 items-center justify-between gap-4">
				<a
					href="/"
					class="rounded-lg"
					aria-label={`${"NaboFlood"} — home`}
				>
					<Wordmark />
				</a>

				<nav class="hidden items-center gap-1 md:flex" aria-label="Main">
					{
						nav.map((item) => (
							<a
								href={item.href}
								aria-current={isActive(item.href) ? "page" : undefined}
								class:list={[
									"rounded-pill px-3.5 py-2 text-sm font-medium transition",
									isActive(item.href)
										? "text-ink bg-surface"
										: "text-ink-dim hover:text-ink hover:bg-surface/60",
								]}
							>
								{item.label}
							</a>
						))
					}
				</nav>

				<div class="hidden md:block">
					<Button
						href={store.released ? store.url : undefined}
						inert={!store.released}
						size="md"
					>
						{store.released ? store.labelReleased : "Coming soon"}
					</Button>
				</div>

				<button
					type="button"
					id="nav-toggle"
					class="text-ink-dim hover:text-ink border-hairline rounded-pill border p-2 md:hidden"
					aria-expanded="false"
					aria-controls="mobile-nav"
					aria-label="Open menu"
				>
					<Icon name="lucide:menu" class="size-5" data-icon-open />
					<Icon name="lucide:x" class="hidden size-5" data-icon-close />
				</button>
			</div>
		</Container>
	</div>

	<!-- mobile drawer -->
	<div
		id="mobile-nav"
		hidden
		class="border-hairline/60 bg-abyss/95 border-b backdrop-blur-xl md:hidden"
	>
		<Container size="wide">
			<nav class="flex flex-col gap-1 py-4" aria-label="Mobile">
				{
					nav.map((item) => (
						<a
							href={item.href}
							class="text-ink-dim hover:text-ink hover:bg-surface rounded-xl px-3 py-3 text-base font-medium transition"
						>
							{item.label}
						</a>
					))
				}
				<div class="pt-2">
					<Button
						href={store.released ? store.url : undefined}
						inert={!store.released}
						size="lg"
						class="w-full"
					>
						{store.released ? store.labelReleased : store.label}
					</Button>
				</div>
			</nav>
		</Container>
	</div>
</header>

{/* the only JavaScript on this site */}
<script>
	const toggle = document.getElementById("nav-toggle");
	const drawer = document.getElementById("mobile-nav");

	if (toggle && drawer) {
		const open = toggle.querySelector("[data-icon-open]");
		const close = toggle.querySelector("[data-icon-close]");

		const setOpen = (next: boolean) => {
			drawer.hidden = !next;
			toggle.setAttribute("aria-expanded", String(next));
			toggle.setAttribute("aria-label", next ? "Close menu" : "Open menu");
			open?.classList.toggle("hidden", next);
			close?.classList.toggle("hidden", !next);
		};

		// `hidden` is typed `boolean | "until-found"` in current lib.dom
		toggle.addEventListener("click", () => setOpen(Boolean(drawer.hidden)));
		drawer.addEventListener("click", (e) => {
			if ((e.target as HTMLElement).closest("a")) setOpen(false);
		});
		document.addEventListener("keydown", (e) => {
			if (e.key === "Escape" && !drawer.hidden) {
				setOpen(false);
				toggle.focus();
			}
		});
	}
</script>
