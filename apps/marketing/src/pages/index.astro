---
import AttributionStrip from "@/components/sections/AttributionStrip.astro";
import CtaSection from "@/components/sections/CtaSection.astro";
import DisclaimerBand from "@/components/sections/DisclaimerBand.astro";
import Faq from "@/components/sections/Faq.astro";
import FeatureGrid from "@/components/sections/FeatureGrid.astro";
import HazardScale from "@/components/sections/HazardScale.astro";
import Hero from "@/components/sections/Hero.astro";
import HowItWorks from "@/components/sections/HowItWorks.astro";
import ProblemStats from "@/components/sections/ProblemStats.astro";
import ScreenshotStrip from "@/components/sections/ScreenshotStrip.astro";
import Base from "@/layouts/Base.astro";
import { landingFaqs } from "@/lib/site";
---

<Base>
	<Hero />
	<DisclaimerBand />
	<ProblemStats />
	<FeatureGrid />
	<HazardScale />
	<HowItWorks />
	<ScreenshotStrip />
	<AttributionStrip />
	<Faq items={landingFaqs} showMore />
	<CtaSection />
</Base>
