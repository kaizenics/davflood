---
import Button from "@/components/ui/Button.astro";
import PageHeader from "@/components/ui/PageHeader.astro";
import Container from "@/components/ui/Container.astro";
import Base from "@/layouts/Base.astro";
import { Icon } from "astro-icon/components";
---

<Base title="Page not found" description="That page doesn't exist.">
	<PageHeader
		eyebrow="404"
		title="This page is underwater."
		lede="The link you followed doesn't lead anywhere. The map, thankfully, still does."
	/>
	<Container size="wide">
		<div class="flex flex-wrap gap-3 pb-24">
			<Button href="/" size="lg">
				<Icon name="lucide:arrow-left" class="size-[1.05rem]" aria-hidden="true" />
				Back to the start
			</Button>
			<Button href="/hazard-levels" variant="outline" size="lg">Hazard levels</Button>
		</div>
	</Container>
</Base>
